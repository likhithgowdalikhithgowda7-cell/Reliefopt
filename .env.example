# ReliefOpt Root Environment Configuration Example
# Copy this file to .env or use project-specific .env in backend/ or frontend/

# Backend Configuration
PROJECT_NAME="ReliefOpt API"
VERSION="1.0.0"
STAGE="Stage 2 - Database Integration & Management"
ENVIRONMENT="development"
DATABASE_URL="postgresql+psycopg://localhost:5432/reliefopt_db"
TEST_DATABASE_URL="postgresql+psycopg://localhost:5432/reliefopt_test_db"
HOST="127.0.0.1"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Frontend Configuration
VITE_API_BASE_URL="http://127.0.0.1:8000"
